+#if VITAPOKE_QOL_REPEL_PROMPT
+
+// SS QoL repel re-use prompt (script bytecode in script_manager.c, commands 853/854 in script_cmd_table.h).
+static u16 sSSRepelItem = ITEM_NONE;
+
+BOOL ScrCmd_SSRepelAsk(ScriptContext *ctx) {
+    // "Use another " in the game charset; the item name and "?" are appended below.
+    static const u16 sUseAnother[] = { 0x013F, 0x0157, 0x0149, 0x01DE, 0x0145, 0x0152, 0x0153, 0x0158, 0x014C, 0x0149, 0x0156, 0x01DE, 0xFFFF };
+    static const u16 sQuestion[] = { 0x01AC, 0xFFFF };
+    FieldSystem *fieldSystem = ctx->fieldSystem;
+    RoamerSaveData *roamerSave = Save_Roamers_Get(fieldSystem->saveData);
+    u16 *result = GetVarPointer(fieldSystem, VAR_SPECIAL_RESULT);
+    u8 fullSteps = roamerSave->unk_66;
+    roamerSave->unk_66 = 0;
+    if (fullSteps > 200) {
+        sSSRepelItem = ITEM_MAX_REPEL;
+    } else if (fullSteps > 100) {
+        sSSRepelItem = ITEM_SUPER_REPEL;
+    } else {
+        sSSRepelItem = ITEM_REPEL;
+    }
+    if (!Bag_HasItem(Save_Bag_Get(fieldSystem->saveData), sSSRepelItem, 1, HEAP_ID_FIELD3)) {
+        printf("[SS-QOL] repel wore off: steps %u, no item %u in bag, no prompt\n", fullSteps, sSSRepelItem);
+        sSSRepelItem = ITEM_NONE;
+        *result = 1;
+        ctx->script_ptr += 4; // skip YesNo VAR_SPECIAL_RESULT
+        return FALSE;
+    }
+    MessageBox messageBox;
+    ovFieldMain_GetMsgBoxParameters(fieldSystem, &messageBox);
+    ovFieldMain_CreateMessageBox(fieldSystem, &messageBox);
+    String *itemName = String_New(64, HEAP_ID_FIELD3);
+    String *question = String_New(4, HEAP_ID_FIELD3);
+    GetItemNameIntoString(itemName, sSSRepelItem, HEAP_ID_FIELD3);
+    CopyU16ArrayToString(question, sQuestion);
+    CopyU16ArrayToString(messageBox.message, sUseAnother);
+    String_Cat(messageBox.message, itemName);
+    String_Cat(messageBox.message, question);
+    String_Delete(question);
+    String_Delete(itemName);
+    ov01_021EF758(&messageBox, 1, ovFieldMain_GetTextFrameDelay(ctx), TRUE, 0);
+    printf("[SS-QOL] repel wore off: steps %u, offering item %u\n", fullSteps, sSSRepelItem);
+    SetupNativeScript(ctx, ov01_021EF348);
+    return TRUE;
+}
+
+BOOL ScrCmd_SSRepelUse(ScriptContext *ctx) {
+    FieldSystem *fieldSystem = ctx->fieldSystem;
+    u16 *result = GetVarPointer(fieldSystem, VAR_SPECIAL_RESULT);
+    if (sSSRepelItem != ITEM_NONE && *result == 0) {
+        Bag *bag = Save_Bag_Get(fieldSystem->saveData);
+        if (Bag_TakeItem(bag, sSSRepelItem, 1, HEAP_ID_FIELD3)) {
+            u8 steps = (u8)GetItemAttr(sSSRepelItem, ITEMATTR_HOLD_EFFECT_PARAM, HEAP_ID_FIELD3);
+            *RoamerSave_GetRepelAddr(Save_Roamers_Get(fieldSystem->saveData)) = steps;
+            PlaySE(SEQ_SE_DP_CARD2);
+            printf("[SS-QOL] repel reuse YES: item %u used, steps %u, another left %d\n", sSSRepelItem, steps, Bag_HasItem(bag, sSSRepelItem, 1, HEAP_ID_FIELD3));
+        }
+    } else if (sSSRepelItem != ITEM_NONE) {
+        printf("[SS-QOL] repel reuse NO: item %u kept\n", sSSRepelItem);
+    }
+    sSSRepelItem = ITEM_NONE;
+    return FALSE;
+}
+#endif
