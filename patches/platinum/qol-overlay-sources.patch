+#if VITAPOKE_QOL_TRADE_EVOS
+/* PSP QoL (2026-09-13): evolution changes copied from Drayano's Renegade Platinum
+   documentation ("Evolution Changes"). Applied to the evolution table in RAM after it is
+   read from the user's ROM; the ROM and the save format are untouched.
+   - every trade evolution without an item (Kadabra, Machoke, Graveler, Haunter) -> level 36
+   - every trade-with-held-item evolution -> the item is used like an evolution stone
+     (Onix/Scyther Metal Coat, Seadra Dragon Scale, Slowpoke/Poliwhirl King's Rock,
+     Porygon Up-Grade, Porygon2 Dubious Disc, Rhydon Protector, Electabuzz Electirizer,
+     Magmar Magmarizer, Dusclops Reaper Cloth, Clamperl DeepSeaTooth/DeepSeaScale)
+   - Budew, Chingling, Riolu evolve when happy regardless of the time
+   - Eevee: Sun Stone -> Espeon, Moon Stone -> Umbreon, Leaf Stone -> Leafeon
+   Not portable to Platinum's item table (items do not exist): Feebas Prism Scale and
+   Eevee Ice Stone; those keep their original methods (Beauty, Ice Rock). */
+static void PSPQoL_ApplyRenegadeEvolutions(u16 species, SpeciesEvolution *evos)
+{
+    for (int i = 0; i < MAX_EVOLUTIONS; i++) {
+        switch (evos[i].method) {
+        case EVO_TRADE:
+            evos[i].method = EVO_LEVEL;
+            evos[i].param = 36;
+            break;
+        case EVO_TRADE_WITH_HELD_ITEM:
+            evos[i].method = EVO_USE_ITEM;
+            break;
+        case EVO_LEVEL_HAPPINESS_DAY:
+        case EVO_LEVEL_HAPPINESS_NIGHT:
+            if (species == SPECIES_EEVEE) {
+                evos[i].param = evos[i].method == EVO_LEVEL_HAPPINESS_DAY ? ITEM_SUN_STONE : ITEM_MOON_STONE;
+                evos[i].method = EVO_USE_ITEM;
+            } else if (species == SPECIES_BUDEW || species == SPECIES_CHINGLING || species == SPECIES_RIOLU) {
+                evos[i].method = EVO_LEVEL_HAPPINESS;
+            }
+            break;
+        case EVO_LEVEL_MOSS_ROCK:
+            if (species == SPECIES_EEVEE) {
+                evos[i].method = EVO_USE_ITEM;
+                evos[i].param = ITEM_LEAF_STONE;
+            }
+            break;
+        }
+    }
+}
+
